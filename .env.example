# VoxAI Open-Model Voice Intelligence Studio Configuration

# APP_URL: Public URL where the application is hosted
APP_URL="http://localhost:3000"

# Backend FastAPI Configuration
VOXAI_BACKEND_HOST="127.0.0.1"
VOXAI_BACKEND_PORT="8001"
VOXAI_DATA_DIR="./data"
VOXAI_MAX_UPLOAD_MB="100"
VOXAI_DEFAULT_ASR_MODEL="faster-whisper-base"
VOXAI_DEFAULT_TTS_MODEL="kokoro-onnx"
VOXAI_STORAGE_BACKEND="local"
VOXAI_RETENTION_DAYS="0"
VOXAI_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional API Bearer token for backend endpoint authentication (leave empty for open local studio)
VOXAI_API_KEY=""

# Optional HuggingFace token for faster model downloads
# HF_TOKEN=""
